{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserConfig",
  "type": "object",
  "properties": {
    "virtual_hosts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VirtualHost"
      }
    }
  },
  "required": [
    "virtual_hosts"
  ],
  "$defs": {
    "VirtualHost": {
      "type": "object",
      "properties": {
        "backends": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BackendMCPGateway"
          }
        }
      },
      "required": [
        "backends"
      ]
    },
    "BackendMCPGateway": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "transport": {
          "$ref": "#/$defs/Transport"
        },
        "passthrough_headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_tool_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool_name_aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "allowed_resource_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_prompt_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "name",
        "url",
        "transport",
        "passthrough_headers",
        "allowed_tool_names",
        "allowed_resource_names",
        "allowed_prompt_names"
      ]
    },
    "Transport": {
      "type": "string",
      "enum": [
        "STREAMABLEHTTP",
        "SSE",
        "STDIO"
      ]
    }
  }
}
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UserConfig",
  "type": "object",
  "properties": {
    "virtual_hosts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/VirtualHost"
      }
    }
  },
  "required": [
    "virtual_hosts"
  ],
  "$defs": {
    "VirtualHost": {
      "type": "object",
      "properties": {
        "backends": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/BackendMCPGateway"
          }
        }
      },
      "required": [
        "backends"
      ]
    },
    "BackendMCPGateway": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "mcp_protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "passthrough_headers": {
          "description": "Header names copied from the downstream request onto the upstream connection.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "add_headers": {
          "description": "Static headers injected onto the upstream connection (override passthrough).",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "remove_headers": {
          "description": "Header names stripped from the upstream connection (applied last).",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "completion": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "tool_schemas": {
          "description": "Input schemas keyed by the original upstream tool name.",
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "required": [
        "name",
        "url",
        "mcp_protocol_version",
        "passthrough_headers",
        "tool_schemas"
      ]
    },
    "ProtocolVersion": {
      "description": "Represents the MCP protocol version used for communication.\n\nThis ensures compatibility between clients and servers by specifying\nwhich version of the Model Context Protocol is being used.",
      "type": "string"
    }  
  }
}
